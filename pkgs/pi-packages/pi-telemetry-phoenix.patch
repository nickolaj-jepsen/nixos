+/**
+ * Fireproof: pi-agents 0.42 runs child agents on pi-durable inside this
+ * process, so there is no child Pi session to instrument. It publishes
+ * lifecycle snapshots instead (pi-agents:state), and this tracer turns one
+ * observed agent run into one span. Snapshots carry id, name, state, and
+ * closed only: generations, tools, usage, and results are not in scope yet.
+ *
+ * The tracer is per Pi session and never consults process globals, so a
+ * snapshot from another session, a restarted publisher, or a new session
+ * cannot be attributed to the spans of this one.
+ */
+import { randomUUID } from 'node:crypto';
+
+export const AGENTS_STATE_EVENT = 'pi-agents:state';
+export const AGENTS_STATE_REQUEST_EVENT = 'pi-agents:state:request';
+
+/** States an agent has while its run is alive. */
+const ACTIVE_STATES = new Set(['working', 'waiting']);
+/** States that end the observed run, with the telemetry event they publish. */
+const TERMINAL_STATES = new Map([
+    ['idle', 'completed'],
+    ['failed', 'failed'],
+    ['interrupted', 'interrupted'],
+    ['skipped', 'skipped'],
+]);
+const CANCEL_REASONS = new Set(['interrupted', 'skipped']);
+
+function isRecord(value) {
+    return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function nonEmptyString(value) {
+    return typeof value === 'string' && value.length > 0 ? value : undefined;
+}
+
+/**
+ * Publishes subagent_started/subagent_* telemetry from pi-agents' lifecycle
+ * snapshots. Construct one per session, after the exporter is ready.
+ */
+export class AgentLifecycleTracer {
+    #publish;
+    #sessionId;
+    #publisherSessionId;
+    #now;
+    #log;
+    #traceId;
+    #publisher;
+    #runs = new Map();
+    #pending = new Map();
+    #seen = new Set();
+    #stoppedInstance;
+    #closed = false;
+    #disposed = false;
+    #queue = Promise.resolve();
+
+    constructor({ publish, sessionId, publisherSessionId = sessionId, traceId, now = Date.now, log = () => {} }) {
+        if (typeof publish !== 'function')
+            throw new TypeError('AgentLifecycleTracer needs a publish function');
+        if (!nonEmptyString(sessionId))
+            throw new TypeError('AgentLifecycleTracer needs the owning session id');
+        if (!nonEmptyString(publisherSessionId))
+            throw new TypeError('AgentLifecycleTracer needs the pi-agents session id');
+        this.#publish = publish;
+        this.#sessionId = sessionId;
+        this.#publisherSessionId = publisherSessionId;
+        this.#traceId = nonEmptyString(traceId);
+        this.#now = now;
+        this.#log = log;
+    }
+
+    get sessionId() {
+        return this.#sessionId;
+    }
+
+    /**
+     * Listen for snapshots and ask for the current one. pi-agents answers a
+     * request synchronously when it already owns the session, and publishes an
+     * initial snapshot when it starts afterwards; both paths reach handle().
+     * @param {{ on: Function, emit: Function }} events Pi's session event bus.
+     * @returns {() => void} Unsubscribe.
+     */
+    subscribe(events) {
+        if (this.#disposed)
+            return () => {};
+        const unsubscribe = events.on(AGENTS_STATE_EVENT, (snapshot) => this.handle(snapshot));
+        try {
+            events.emit(AGENTS_STATE_REQUEST_EVENT, Object.freeze({ protocol: 1 }));
+        }
+        catch (error) {
+            this.#log(error);
+        }
+        return unsubscribe;
+    }
+
+    /**
+     * The main trace new runs hang from. Undefined outside a chat turn, so a
+     * restored agent waits for a span to parent to instead of becoming a
+     * detached trace.
+     */
+    setTraceId(traceId) {
+        if (this.#closed || this.#disposed)
+            return;
+        this.#traceId = nonEmptyString(traceId);
+        if (this.#traceId)
+            this.#startPending();
+    }
+
+    /** Observe one pi-agents lifecycle snapshot. */
+    handle(snapshot) {
+        if (this.#closed || this.#disposed || !isRecord(snapshot))
+            return;
+        if (snapshot.protocol !== 1)
+            return;
+        // The event bus is process-wide: only this session's publisher may
+        // attribute runs here. In a nested pi process the publisher's session
+        // id is local, while the trace lineage stays with the root session.
+        if (snapshot.sessionId !== this.#publisherSessionId)
+            return;
+        const instanceId = nonEmptyString(snapshot.instanceId);
+        if (!instanceId)
+            return;
+        if (instanceId === this.#stoppedInstance)
+            return;
+        if (snapshot.type === 'stopped') {
+            if (this.#publisher && this.#publisher.instanceId !== instanceId)
+                return;
+            this.#finishAll('publisher_stopped');
+            this.#pending.clear();
+            this.#seen.clear();
+            this.#publisher = undefined;
+            this.#stoppedInstance = instanceId;
+            return;
+        }
+        if (snapshot.type !== 'snapshot' || !Array.isArray(snapshot.agents))
+            return;
+        const sequence = Number.isSafeInteger(snapshot.sequence)
+            ? snapshot.sequence
+            : undefined;
+        if (this.#publisher && this.#publisher.instanceId === instanceId) {
+            // Snapshots are ordered within one publisher; a late one must not
+            // reopen a run this tracer already settled.
+            if (sequence !== undefined && sequence <= this.#publisher.sequence)
+                return;
+        }
+        else if (this.#publisher) {
+            // A new publisher instance means the previous session scope is
+            // gone. Its spans cannot be completed honestly, so close them.
+            this.#finishAll('publisher_replaced');
+            this.#pending.clear();
+            this.#seen.clear();
+        }
+        this.#publisher = {
+            instanceId,
+            sequence: sequence ?? (this.#publisher?.sequence ?? 0) + 1,
+        };
+        const seen = new Set();
+        for (const value of snapshot.agents) {
+            if (!isRecord(value))
+                continue;
+            const id = nonEmptyString(value.id);
+            if (!id || seen.has(id))
+                continue;
+            seen.add(id);
+            this.#observe({
+                id,
+                name: nonEmptyString(value.name) ?? id,
+                state: nonEmptyString(value.state) ?? 'unknown',
+                closed: value.closed === true,
+                restored: !this.#seen.has(id),
+            });
+        }
+        // A closed agent that no longer works is hidden from the snapshot. A
+        // failure or interruption between snapshots would be hidden with it,
+        // so this is not an observed success. End the span with the exporter's
+        // completed event (it has no unknown terminal event) and label why.
+        for (const id of [...this.#runs.keys()])
+            if (!seen.has(id))
+                this.#finish(id, 'closed', { outcome: 'closed' });
+        for (const id of [...this.#pending.keys()])
+            if (!seen.has(id))
+                this.#pending.delete(id);
+        this.#seen = seen;
+    }
+
+    /** Wait until every event queued so far has reached the exporter. */
+    async flush() {
+        await this.#queue;
+    }
+
+    /**
+     * End every open run because this process stops observing them. Call
+     * before the exporter closes, so the terminal spans are queued for export.
+     * @param {string} reason session_shutdown, session_restarted, or similar.
+     */
+    async close(reason = 'session_shutdown') {
+        if (this.#disposed)
+            return this.#queue;
+        this.#closed = true;
+        this.#pending.clear();
+        this.#finishAll(reason);
+        this.#publisher = undefined;
+        await this.#queue;
+    }
+
+    /** Drop listeners and buffered state; call close() first to export them. */
+    dispose() {
+        if (this.#disposed)
+            return;
+        this.#disposed = true;
+        this.#pending.clear();
+        this.#runs.clear();
+        this.#seen.clear();
+        this.#publisher = undefined;
+        this.#traceId = undefined;
+    }
+
+    #observe(agent) {
+        const run = this.#runs.get(agent.id);
+        if (ACTIVE_STATES.has(agent.state)) {
+            if (run) {
+                run.name = agent.name;
+                run.state = agent.state;
+                return;
+            }
+            if (!this.#traceId) {
+                const pending = this.#pending.get(agent.id);
+                this.#pending.set(agent.id, {
+                    name: agent.name,
+                    state: agent.state,
+                    restored: pending?.restored ?? agent.restored,
+                });
+                return;
+            }
+            this.#start(agent);
+            return;
+        }
+        const outcome = TERMINAL_STATES.get(agent.state);
+        if (outcome === undefined)
+            return;
+        if (run)
+            this.#finish(agent.id, outcome, {
+                outcome,
+                state: agent.state,
+                ...(agent.closed ? { closed: true } : {}),
+            });
+        else
+            this.#pending.delete(agent.id);
+    }
+
+    #startPending() {
+        for (const [id, pending] of [...this.#pending]) {
+            if (!this.#traceId)
+                return;
+            this.#start({
+                id,
+                name: pending.name,
+                state: pending.state,
+                closed: false,
+                restored: pending.restored,
+            });
+        }
+    }
+
+    #start(agent) {
+        if (!this.#traceId)
+            return;
+        const run = {
+            id: agent.id,
+            name: agent.name,
+            state: agent.state,
+            runId: randomUUID(),
+            traceId: this.#traceId,
+            startedAt: this.#now(),
+        };
+        this.#runs.set(agent.id, run);
+        this.#pending.delete(agent.id);
+        this.#emit({
+            type: 'subagent_started',
+            traceId: run.traceId,
+            sessionId: this.#sessionId,
+            parentSessionId: this.#sessionId,
+            childSessionId: agent.id,
+            runId: run.runId,
+            createdAt: new Date(run.startedAt).toISOString(),
+            details: {
+                agent: run.name,
+                agentId: agent.id,
+                agentState: agent.state,
+                lifecycleSource: 'pi-agents:state',
+                ...(agent.restored ? { restored: true } : {}),
+            },
+        });
+    }
+
+    #finish(id, outcome, details = {}) {
+        const run = this.#runs.get(id);
+        if (!run)
+            return;
+        this.#runs.delete(id);
+        const now = this.#now();
+        const { state, ...rest } = details;
+        const cancelled = CANCEL_REASONS.has(outcome) || outcome.startsWith('publisher_') || outcome === 'session_shutdown' || outcome === 'session_restarted';
+        this.#emit({
+            type: cancelled
+                ? 'subagent_cancelled'
+                : outcome === 'failed'
+                    ? 'subagent_failed'
+                    : 'subagent_completed',
+            traceId: run.traceId,
+            sessionId: this.#sessionId,
+            parentSessionId: this.#sessionId,
+            childSessionId: id,
+            runId: run.runId,
+            createdAt: new Date(now).toISOString(),
+            durationMs: Math.max(0, now - run.startedAt),
+            // A failure is classified, not quoted: pi-agents keeps the error
+            // text in its own conversation, and it can contain user content.
+            ...(outcome === 'failed' ? { error: 'Agent failed' } : {}),
+            details: {
+                agent: run.name,
+                agentId: id,
+                ...(state ? { agentState: state } : {}),
+                lifecycleSource: 'pi-agents:state',
+                outcome,
+                ...rest,
+            },
+        });
+    }
+
+    #finishAll(outcome) {
+        for (const id of [...this.#runs.keys()])
+            this.#finish(id, outcome, { outcome });
+    }
+
+    #emit(event) {
+        const value = { id: randomUUID(), ...event };
+        // A publish failure must not break pi-agents' synchronous event bus.
+        this.#queue = this.#queue
+            .then(() => this.#publish(value))
+            .catch((error) => this.#log(error));
+    }
+}
