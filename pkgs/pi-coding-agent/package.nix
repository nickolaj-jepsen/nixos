# Tracks pi releases ahead of nixpkgs, the way pkgs/claude-code does: the pins
# live in ./release.json and the build is nixpkgs'.
#
# nixpkgs hardcodes those pins inside its buildNpmPackage argument function, so
# overrideAttrs alone would only reach the derivation: the dependency cache is
# computed from the pinned lock hash before overrides apply, so it is replaced
# here. A bump needs four values:
#
#   version        npm's `latest` for @earendil-works/pi-coding-agent
#   srcHash        nix store prefetch-file --unpack \
#                    https://github.com/earendil-works/pi/archive/refs/tags/v<version>.tar.gz
#   npmDepsHash    prefetch-npm-deps <src>/package-lock.json
#   modelDataHash  nix store prefetch-file \
#                    https://registry.npmjs.org/@earendil-works/pi-ai/-/pi-ai-<version>.tgz
#
# pi-ai's model catalog is generated by a network fetch and gitignored upstream,
# so it is not in the source tarball; modelData restores it from that npm package.
{
  lib,
  unstable,
}: let
  release = lib.importJSON ./release.json;
  src = unstable.fetchFromGitHub {
    owner = "earendil-works";
    repo = "pi";
    tag = "v${release.version}";
    hash = release.srcHash;
  };
  modelData = unstable.fetchurl {
    url = "https://registry.npmjs.org/@earendil-works/pi-ai/-/pi-ai-${release.version}.tgz";
    hash = release.modelDataHash;
  };
in
  unstable.pi-coding-agent.overrideAttrs {
    inherit (release) version;
    inherit src modelData;
    npmDeps = unstable.fetchNpmDeps {
      name = "pi-coding-agent-${release.version}-npm-deps";
      inherit src;
      hash = release.npmDepsHash;
    };
  }
