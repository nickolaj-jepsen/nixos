{inputs, ...}: {
  imports = [inputs.treefmt-nix.flakeModule];

  perSystem = {config, ...}: {
    treefmt = {
      projectRootFile = "flake.nix";
      programs = {
        deadnix.enable = true;
        alejandra.enable = true;
        statix.enable = true;
        just.enable = true;
        oxfmt.enable = true;
        fish_indent.enable = true;
      };
      settings.global.excludes = [
        "result"
        "docs/fireproof-options.md" # Generated by CI (update-docs.yml)
        "hosts/*/facter.json" # Generated by nixos-facter
        "modules/programs/claude-code/mods/answer/tests/views.ts" # Generated by views.py, which --check compares
        "modules/programs/obsidian/plugin.js" # replaceVars template, not valid JS until substituted
        "skills/onboard/scripts/vendor/*" # Vendored Pele, kept byte-identical to upstream
        "*.{gitignore,age,pub,svg}"
      ];
    };
    formatter = config.treefmt.build.wrapper;
  };
}
