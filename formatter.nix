{inputs, ...}: {
  imports = [inputs.treefmt-nix.flakeModule];

  perSystem = {config, ...}: {
    treefmt = {
      projectRootFile = "flake.nix";
      programs = {
        deadnix.enable = true;
        alejandra.enable = true;
        statix.enable = true;
        just.enable = true;
        oxfmt.enable = true;
        fish_indent.enable = true;
        # The update bot is the most intricate code here; lint it and the workflows that run it.
        actionlint.enable = true;
        zizmor.enable = true;
        ruff-check.enable = true;
        ruff-format = {
          enable = true;
          lineLength = 120; # smallest reflow of the existing scripts; the default 88 rewraps most of them
        };
        shellcheck.enable = true;
      };
      # Online audits need the GitHub API, which the sandboxed `checks.treefmt` build doesn't have.
      settings.formatter.zizmor.options = ["--offline"];
      settings.formatter.shellcheck.excludes = [".envrc"]; # direnv syntax, not a script
      settings.global.excludes = [
        "result"
        "docs/fireproof-options.md" # Generated by `just docs`
        "hosts/*/facter.json" # Generated by nixos-facter
        "modules/programs/obsidian/plugin.js" # replaceVars template, not valid JS until substituted
        "*.{gitignore,age,pub,svg}"
      ];
    };
    formatter = config.treefmt.build.wrapper;
  };
}
