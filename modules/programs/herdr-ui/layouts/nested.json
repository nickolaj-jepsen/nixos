{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "column",
  "padding": [0, 8],
  "gap": 0,
  "children": [
    {
      "id": "header-inset",
      "type": "column",
      "size": {
        "px": 8
      },
      "children": []
    },
    {
      "id": "tabs",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "nested-header"
      }
    },
    {
      "id": "workspace",
      "type": "row",
      "gap": 8,
      "resizable": false,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "sidebar-lists",
              "type": "column",
              "padding": [8, 0],
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "nested-spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            }
          ],
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "canvas",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": [8, 0],
              "gap": 8
            }
          ],
          "resizable": false
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "nested-status"
      },
      "size": {
        "px": 30
      }
    },
    {
      "id": "footer-inset",
      "type": "column",
      "size": {
        "px": 8
      },
      "children": []
    }
  ],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "titlebar": "none",
  "traffic_lights": [12, 16]
}
